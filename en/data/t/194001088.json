[[31,1,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Release the cover (1a) from the knob (1b).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/194001475.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[31,1,0,"<p>1. Using the internal retaining clips (1a) release the knob (1b) from its housing.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/194001476.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[31,1,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>1. Fit the knob (1a) positioning the retaining clips (1b) at the points shown by the arrows.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/194001477.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[31,1,0,"<p>- Fit the cover on the knob.</p>"]]