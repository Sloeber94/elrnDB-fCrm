[[31,1,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>- Turn the ignition key to the OFF position.</p><p>- Disconnect the negative battery terminal.</p><div class=\"table\"><table><tr><th></th><th><p>Description</p></th><th><p>Connector</p></th></tr><tr><td></td><td><p>BATTERY</p></td><td><p><a href=\"#/194002560\">See A001 BATTERY</a></p></td></tr></table></div><p>1. Engage extractors (1a) in holes (1b) and remove radio (1c).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/194001202.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[31,1,0,"<p>1. Disconnect the electrical connections (1a), (1b), (1c), (1d), (1e), aerial connection (1f) and remove radio (1g).</p><div class=\"table\"><table><tr><th></th><th><p>Description</p></th><th><p>Connector</p></th></tr><tr><td><p>1a</p></td><td><p>RADIO</p></td><td><p><a href=\"#/194002767\">See P020</a></p></td></tr></table></div><div class=\"table\"><table><tr><th></th><th><p>Description</p></th><th><p>Connector</p></th></tr><tr><td><p>1b</p></td><td><p>RADIO</p></td><td><p><a href=\"#/194002767\">See P020</a></p></td></tr></table></div><div class=\"table\"><table><tr><th></th><th><p>Description</p></th><th><p>Connector</p></th></tr><tr><td><p>1c</p></td><td><p>RADIO</p></td><td><p><a href=\"#/194002767\">See P020</a></p></td></tr></table></div><div class=\"table\"><table><tr><th></th><th><p>Description</p></th><th><p>Connector</p></th></tr><tr><td><p>1d</p></td><td><p>RADIO</p></td><td><p><a href=\"#/194002767\">See P020</a></p></td></tr></table></div><div class=\"table\"><table><tr><th></th><th><p>Description</p></th><th><p>Connector</p></th></tr><tr><td><p>1e</p></td><td><p>RADIO</p></td><td><p><a href=\"#/194002767\">See P020</a></p></td></tr></table></div><div class=\"table\"><table><tr><th></th><th><p>Description</p></th><th><p>Connector</p></th></tr><tr><td><p>1f</p></td><td><p>RADIO</p></td><td><p><a href=\"#/194002767\">See P020</a></p></td></tr></table></div><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/194001203.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[31,1,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>- Check the condition of the radio.</p><p>Connect the electrical connections and the connections for the aerials.</p><div class=\"table\"><table><tr><th></th><th><p>Description</p></th><th><p>Connector</p></th></tr><tr><td></td><td><p>RADIO</p></td><td><p><a href=\"#/194002767\">See P020</a></p></td></tr></table></div><p>- Fit the radio in its housing.</p><p>- Connect the battery terminal.</p><div class=\"table\"><table><tr><th></th><th><p>Description</p></th><th><p>Connector</p></th></tr><tr><td></td><td><p>BATTERY</p></td><td><p><a href=\"#/194002560\">See A001 BATTERY</a></p></td></tr></table></div>"]]