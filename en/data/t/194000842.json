[[31,1,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>- Open the front side door.</p><p>1. Undo the fixing bolts.</p><p>2. Remove the lock striker.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/194001274.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[31,1,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>- Position the lock striker and screw in the fixing bolts without tightening them to torque.</p><p><a href=\"#/194000834\">Op. 7005A10 FRONT SIDE DOOR - ADJUST STRIKER AND ADAPT SEAL IF NECESSARY</a></p>"]]