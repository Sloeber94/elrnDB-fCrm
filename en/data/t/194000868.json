[[31,1,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Release the retaining pins using the special tool.</p><div class=\"table\"><table><tr><th><p>Tool</p></th><th><p>Description</p></th><th><p>Function</p></th><th><p>Validity</p></th></tr><tr><td><p>1878077000</p></td><td><p>Knife</p></td><td><p>Retainer removal</p></td><td></td></tr></table></div><p>2. Remove the upper cover.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/194001299.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[31,1,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>- Check that the cover and retaining pins are not damaged.</p><p>- Fit the upper cover pressing in the areas of the retaining pins.</p>"]]