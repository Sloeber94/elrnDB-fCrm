[[31,1,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>- Open the bonnet.</p><p>1. Release the seal starting from one end and remove it from its housing.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/194001396.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[31,1,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>- Check that the seal is intact and there are no signs of damage.</p><p>- Position the seal and fit it in its housing and attach it starting at one end.</p>"]]