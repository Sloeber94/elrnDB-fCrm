[[2,1,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Working at the bench, withdraw clip (1a) and remove injector (1b) from the common rail (1c).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/194000419.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2,1,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>1. Replace the seals on the injector.</p><aside class=\"note\"><img class=\"icon\" src=\"../media/767.jpg\" alt=\"\" loading=\"lazy\"><p>Moisten the new seals with engine oil.</p></aside><p>2. Refit the common rail (2a), injector (2b) and secure with clip (2c).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/194000420.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[1,1,0,"<p><a href=\"#/194000318\">Op. 1056B60 SINGLE FUEL MANIFOLD PIPE, WITH INJECTORS - R.R.</a></p>"]]